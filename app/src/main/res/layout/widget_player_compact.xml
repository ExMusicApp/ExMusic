<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/w_info"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical">

            <TextView
                android:id="@+id/w_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="34dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_idle_title"
                android:textColor="@color/widget_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_idle_subtitle"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

                <ImageButton
                android:id="@+id/w_prev"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_prev"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ms_skip_previous"
                android:tint="@color/widget_text" />
                <ImageButton
                    android:id="@+id/w_play"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/widget_btn_play_bg"
                    android:contentDescription="@string/widget_play"
                    android:padding="10dp"
                    android:src="@drawable/ms_play_arrow"
                    android:tint="@color/widget_on_accent" />
                <ImageButton
                    android:id="@+id/w_next"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_next"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ms_skip_next"
                    android:tint="@color/widget_text" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/w_open"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="top|end"
        android:background="@drawable/widget_btn_bg"
        android:contentDescription="@string/widget_open_player"
        android:padding="7dp"
        android:src="@drawable/ms_open_in_new"
        android:tint="@color/widget_text" />
</FrameLayout>
