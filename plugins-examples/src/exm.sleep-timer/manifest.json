{
  "id": "exm.sleep-timer",
  "name": "Таймер сна",
  "version": "1.2.0",
  "author": "ExMusic",
  "description": "Ставит музыку на паузу после заданного времени прослушивания, плавно убавляя громкость.",
  "api": 2,
  "icon": "icon.png",
  "contributes": {
    "lua": {
      "main": "main.lua"
    },
    "settings": [
      {
        "key": "minutes",
        "type": "slider",
        "title": "Пауза через, минут",
        "summary": "Считается время, пока музыка реально играет",
        "min": 5,
        "max": 180,
        "step": 5,
        "default": 30
      },
      {
        "key": "fade_seconds",
        "type": "slider",
        "title": "Плавное затухание, секунд",
        "summary": "0 — без затухания",
        "min": 0,
        "max": 120,
        "step": 5,
        "default": 20
      }
    ]
  }
}
